# URL til menighetssiden (for å bygge verifiseringslenker)
PUBLIC_BASE_URL=http://localhost:5173

# E-post via Resend (resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
